generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Better Auth (core tables)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("patient")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions            Session[]
  accounts            Account[]
  appointments        Appointment[]
  intakeForm          IntakeForm?
  psychologistProfile Psychologist?
  patientNotes        PatientNote[]
  approvalsRequested  ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided    ApprovalRequest[] @relation("ApprovalDecidedBy")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// Business models
// ==========================================

model Psychologist {
  id                    String        @id @default(cuid())
  userId                String?       @unique
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  slug                  String        @unique
  email                 String        @unique
  phone                 String?
  photoUrl              String?
  specialty             String
  bio                   String        @db.Text
  sessionDuration       Int           @default(60)
  offeredSessionTypes   SessionType[] @default([INDIVIDUAL])
  coupleSessionDuration Int           @default(120)
  calendarId            String?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  schedules    Schedule[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  patientNotes PatientNote[]

  @@map("psychologist")
}

model Schedule {
  id             String       @id @default(cuid())
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean      @default(true)

  @@index([psychologistId])
  @@map("schedule")
}

model TimeOff {
  id             String       @id @default(cuid())
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([psychologistId])
  @@map("time_off")
}

model Appointment {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologistId   String
  psychologist     Psychologist      @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  dateTime         DateTime
  endTime          DateTime
  status           AppointmentStatus @default(PENDING_FORM)
  expiresAt        DateTime?
  googleEventId    String?
  notes            String?           @db.Text
  internalNotes    String?           @db.Text
  patientCountry   String?
  termsVersion     String?
  termsAcceptedAt  DateTime?
  finalizedAt      DateTime?
  timezone         String?
  isException      Boolean           @default(false)
  selfBookedAt     DateTime?
  sessionType      SessionType       @default(INDIVIDUAL)
  agreedAmount     Int?
  agreedCurrency   String?
  agreedPayoutType PayoutType?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  intakeFormOrigin IntakeForm? @relation("IntakeFormOrigin")
  payment          Payment?

  @@index([userId])
  @@index([psychologistId])
  @@index([dateTime])
  @@index([status, finalizedAt])
  @@map("appointment")
}

enum AppointmentStatus {
  PENDING_FORM
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SessionType {
  INDIVIDUAL
  COUPLE
}

model IntakeForm {
  id                            String       @id @default(cuid())
  appointmentId                 String?      @unique
  appointment                   Appointment? @relation("IntakeFormOrigin", fields: [appointmentId], references: [id], onDelete: SetNull)
  userId                        String       @unique
  user                          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  data                          Json
  clinicalDataConsentVersion    String?
  clinicalDataConsentAcceptedAt DateTime?
  clinicalDataRedactedAt        DateTime?
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  @@map("intake_form")
}

model PatientNote {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("patient_note")
}

model Payment {
  id                         String        @id @default(cuid())
  appointmentId              String        @unique
  appointment                Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId    String?       @unique
  stripeCheckoutUrl          String?
  stripePaymentIntentId      String?       @unique
  currency                   String        @default("COP")
  amount                     Int
  discountAmount             Int           @default(0)
  finalAmount                Int
  exchangeRateToUsd          Float?
  status                     PaymentStatus @default(PENDING)
  method                     String?
  couponId                   String?
  coupon                     Coupon?       @relation(fields: [couponId], references: [id])
  paidAt                     DateTime?
  isFirstAppointment         Boolean?
  payoutType                 PayoutType?
  payoutRatePercent          Float?
  payoutAmountUsd            Float?
  isNoShowFee                Boolean       @default(false)
  stripeChargeId             String?       @unique
  stripeBalanceTransactionId String?       @unique
  stripeSettledAmountUsd     Float?
  stripeFeeUsd               Float?
  stripeSettlementRate       Float?
  stripeSettlementCheckedAt  DateTime?
  refundStatus               RefundStatus?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@index([couponId])
  @@map("payment")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum RefundStatus {
  PENDING_EXECUTION
  EXECUTED
}

/**
 * Approval workflow (Fase 5): a psychologist requests something (a custom
 * payment amount, or a refund correction on a wrongly-charged payment);
 * admin/assistant decide it. `targetId` is deliberately not an FK — it's
 * polymorphic (an appointmentId for CUSTOM_PAYMENT_AMOUNT, a paymentId for
 * REFUND_REQUEST), resolved by type in application code.
 */
model ApprovalRequest {
  id               String         @id @default(cuid())
  type             ApprovalType
  status           ApprovalStatus @default(PENDING)
  requestedByUserId String
  requestedBy      User           @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  targetId         String
  payload          Json
  decidedByUserId  String?
  decidedBy        User?          @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decisionNote     String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([requestedByUserId])
  @@index([status])
  @@index([targetId])
  @@map("approval_request")
}

enum ApprovalType {
  CUSTOM_PAYMENT_AMOUNT
  REFUND_REQUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutType {
  RECURRING
  NEW
  LOYAL
  LOYAL_NEW
}

enum RateKind {
  INDIVIDUAL
  COUPLE
  NO_SHOW_FEE
}

model PaymentRate {
  id        String   @id @default(cuid())
  currency  String
  kind      RateKind @default(INDIVIDUAL)
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currency, kind])
  @@map("payment_rate")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rateToUsd Float
  updatedAt DateTime @updatedAt

  @@map("exchange_rate")
}

model SiteSettings {
  id             String   @id @default("singleton")
  whatsappNumber String?
  instagramUrl   String?
  contactEmail   String?
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}

model PayoutSettings {
  id                         String   @id @default("singleton")
  newClientRatePercent       Float    @default(27)
  recurringClientRatePercent Float    @default(54)
  loyalRatePercent           Float    @default(54)
  loyalNewRatePercent        Float    @default(27)
  updatedAt                  DateTime @updatedAt

  @@map("payout_settings")
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxUses         Int?
  currentUses     Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments Payment[]

  @@map("coupon")
}
